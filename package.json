{
  "name": "clipperx-ui",
  "private": true,
  "version": "4.8.0",
  "description": "Local-first AI video reframing and narrative editing desktop application.",
  "author": "ClipperX",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:api": "node backend/server.mjs",
    "doctor": "node scripts/doctor.mjs",
    "test:engine": "node scripts/run-python.mjs -m unittest discover -s tests -v",
    "build": "tsc --noEmit -p tsconfig.app.json && vite build",
    "preview": "vite preview",
    "start": "node backend/server.mjs",
    "desktop": "node scripts/desktop-dev.mjs",
    "desktop:package": "npm run build && electron-builder --win nsis --x64",
    "desktop:installer": "npm run build && electron-builder --win nsis --x64",
    "setup:engine": "node scripts/setup-engine.mjs",
    "release:check": "node scripts/release-check.mjs",
    "benchmark:init": "node scripts/benchmark.mjs init --root benchmark-50",
    "benchmark:baselines": "node scripts/benchmark.mjs baselines --root benchmark-50",
    "benchmark:evaluate": "node scripts/benchmark.mjs evaluate --root benchmark-50"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.2.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.2",
    "vite": "^5.3.4",
    "electron": "^31.2.1",
    "electron-builder": "^24.13.3"
  },
  "main": "desktop/main.cjs",
  "build": {
    "directories": {
      "output": "release"
    },
    "appId": "com.clipperx.desktop",
    "productName": "ClipperX",
    "asarUnpack": [
      "backend/**/*",
      "engine/**/*"
    ],
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "backend/**/*",
      "engine/**/*",
      "requirements*.txt",
      "package.json",
      ".clipperx-python.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "ClipperX-Setup-${version}-${arch}.${ext}",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ClipperX",
      "runAfterFinish": true
    }
  }
}
