# Optional runtime settings
CLIPPERX_API_PORT=8787
CLIPPERX_DATA_DIR=./runtime
CLIPPERX_MAX_UPLOAD_BYTES=2147483648
CLIPPERX_CONCURRENCY=1
CLIPPERX_PYTHON=python

# Optional Hugging Face token for pyannote speaker diarization.
HF_TOKEN=

# API keys are intentionally not stored in .env by default.
# They are sent per request from the local UI to the selected provider.
